# MiniMax API key is read from this environment variable; never commit the real value.
MINIMAX_API_KEY=sk-api-REPLACE_ME
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_API_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2

# seekdb / OceanBase connection.
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2898
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=minimax_sdd
